function abrirCadastroRapido(itemIdx){
    _cadastroRapidoItemIdx = itemIdx;
    const item = _nomesPendentes[itemIdx];
    if(!item) return;
    document.getElementById('cadNome').value = item.nomeEditavel || item.nomePDF || '';
    document.getElementById('cadCPF').value = '';
    document.getElementById('cadSalario').value = item.dados.salarioBase || '';
    document.getElementById('cadUnidade').value = '';
    document.getElementById('cadDepartamento').value = '';
    document.getElementById('cadCargo').value = '';
    document.getElementById('cadPermanencia').value = '08:00';
    document.getElementById('cadAdmissao').value = '';
    document.getElementById('cadastroRapidoErro').style.display = 'none';
    document.getElementById('modalCadastroRapido').classList.add('active');
}
function fecharCadastroRapido(){
    document.getElementById('modalCadastroRapido').classList.remove('active');
    _cadastroRapidoItemIdx = null;
}
async function salvarCadastroRapido(){
    const erroDiv = document.getElementById('cadastroRapidoErro');
    erroDiv.style.display = 'none';
    const nome = (document.getElementById('cadNome').value || '').trim();
    if(!nome || nome.length < 3){
        erroDiv.textContent = 'Informe o nome completo do funcionário (mínimo 3 caracteres).';
        erroDiv.style.display = 'block';
        return;
    }
    const cpf = (document.getElementById('cadCPF').value || '').trim();
    const salario = parseFloat(document.getElementById('cadSalario').value) || 0;
    const unidade = document.getElementById('cadUnidade').value || null;
    const departamento = (document.getElementById('cadDepartamento').value || '').trim() || null;
    const cargo = (document.getElementById('cadCargo').value || '').trim() || null;
    const permanencia = document.getElementById('cadPermanencia').value || '08:00';
    const admissao = document.getElementById('cadAdmissao').value || null;

    const duplicado = funcionarios.find(f=>normalizarNome(f.nome) === normalizarNome(nome));
    if(duplicado){
        erroDiv.textContent = `Já existe um funcionário cadastrado com este nome: "${duplicado.nome}". Selecione-o na lista.`;
        erroDiv.style.display = 'block';
        return;
    }

    const btn = document.querySelector('#modalCadastroRapido .btn-success');
    if(btn){ btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...'; }

    try{
        const payload = { nome, salario: salario > 0 ? salario : 2500, permanencia };
        if(cpf) payload.cpf = cpf;
        if(unidade) payload.unidade = unidade;
        if(departamento) payload.departamento = departamento;
        if(cargo) payload.cargo = cargo;
        if(admissao) payload.admissao = admissao;

        const resp = await salvarComFallback(
            'legacy_funcionarios',
            (p)=>dbLegacy.from('funcionarios').insert(p).select().single(),
            payload
        );
        if(!resp.ok) throw resp.error;
        const data = resp.data;
        if(!data || !data.id) throw new Error('Cadastro retornou sem ID. Verifique as políticas RLS da tabela.');

        const novoFuncionario = { ...data, desligamento: data.desligamento || data.demissao || null };
        funcionarios.push(novoFuncionario);
        funcionarios.sort((a,b)=>(a.nome || '').localeCompare(b.nome || ''));

        if(_cadastroRapidoItemIdx !== null && _nomesPendentes[_cadastroRapidoItemIdx]){
            const pend = _nomesPendentes[_cadastroRapidoItemIdx];
            pend.funcionarioId = data.id;
            pend.nomeEditavel = data.nome;
            pend.sugestoes = [{ funcionario:novoFuncionario, similaridade:100 }];
            const itemPreview = _importPreviewData.find(p=>p._uid === pend.uid);
            if(itemPreview){
                itemPreview.funcionarioId = data.id;
                itemPreview.nomeEditavel = data.nome;
                itemPreview.matchExato = true;
                itemPreview.sugestaoNome = data.nome;
            }
        }
        fecharCadastroRapido();
        renderizarNomesPendentes();
        renderizarPreviewImportacao(_importPreviewData);
        mostrarToast(`✅ "${data.nome}" cadastrado e vinculado com sucesso!`, '');
    }catch(e){
        console.error('Erro ao cadastrar funcionário:', e);
        erroDiv.textContent = 'Erro ao cadastrar na base: ' + (e.message || e) + ' — você ainda pode cancelar e confirmar o nome digitado no pop-up.';
        erroDiv.style.display = 'block';
        mostrarToast('❌ Erro: ' + (e.message || e), 'error');
    }finally{
        if(btn){ btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Salvar e Vincular'; }
    }
}

