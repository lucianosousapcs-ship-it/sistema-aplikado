   EXTRAÇÃO POR COORDENADAS (PDF)
   ============================================================ */
const ROTULOS_IGNORADOS_NOME = ['DEPARTAMENTO','CBO','FIAL','ADMISSAO','ADMISSÃO','NOME DO FUNCIONARIO','NOME DO FUNCIONÁRIO','FOLHA MENSAL','MENSALISTA','HORISTA','CODIGO','CÓDIGO','DESCRICAO','DESCRIÇÃO','REFERENCIA','REFERÊNCIA','VENCIMENTOS','DESCONTOS','CC','CNPJ','TOTAL DE VENCIMENTOS','TOTAL DE DESCONTOS','VALOR LIQUIDO','SALARIO BASE','SAL. CONTR. INSS','BASE CALC. FGTS','F.G.TS DO MES','BASE CALC. IRRF','FAIXA IRRF','MATRICULA INSS','MATRÍCULA INSS','ASSINATURA DO FUNCIONARIO','ASSINATURA DO FUNCIONÁRIO','DATA','DOCUMENTO','RECIBO','PAGAMENTO','J D QUINTINO','RESTAURANTE','PIRAI','PIRAÍ'];

function agruparItensEmLinhas(items, toleranciaY = 3.5){
    const arr = items.filter(it=>it.str && it.str.trim() !== '').map(it=>({
        text: it.str.replace(/\s+/g,' ').trim(),
        x: it.transform[4],
        y: it.transform[5],
        w: it.width || 0,
        h: it.height || 0
    }));
    arr.sort((a,b)=>(b.y - a.y) || (a.x - b.x));
    const linhas = [];
    for(const item of arr){
        let linha = linhas.find(l=>Math.abs(l.y - item.y) <= toleranciaY);
        if(!linha){ linha = { y: item.y, itens: [] }; linhas.push(linha); }
        linha.itens.push(item);
    }
    linhas.forEach(l=>l.itens.sort((a,b)=>a.x - b.x));
    linhas.sort((a,b)=>b.y - a.y);
    return linhas;
}
function acharRotulo(linhas, ...variacoes){
    const alvos = variacoes.map(v=>normalizarNome(v));
    for(const linha of linhas){
        for(const item of linha.itens){
            const t = normalizarNome(item.text);
            if(alvos.some(a=>t === a || t.includes(a))) return { x:item.x, y:item.y, item, linha };
        }
    }
    return null;
}
function acharXColunaDescontos(linhas){
    for(const linha of linhas){
        for(const item of linha.itens){
            if(normalizarNome(item.text).includes('DESCONTOS')) return item.x;
        }
    }
    return null;
}
function acharValorAbaixo(linhas, rotulo, toleranciaX = 60, maxLinhasAbaixo = 6){
    if(!rotulo) return null;
    const linhaRotuloY = rotulo.y;
    let cont = 0;
    for(const linha of linhas){
        if(linha.y >= linhaRotuloY - 0.5) continue;
        cont++;
        if(cont > maxLinhasAbaixo) break;
        let melhor = null, melhorDist = Infinity;
        for(const item of linha.itens){
            if(!/^R?\$?\s*[\d.,]+$/.test(item.text)) continue;
            const dist = Math.abs(item.x - rotulo.x);
            if(dist <= toleranciaX && dist < melhorDist){ melhor = item; melhorDist = dist; }
        }
        if(melhor) return melhor.text;
    }
    return null;
}
function acharValorNaLinha(linhas, rotulo, toleranciaY = 4, maxDistX = 500){
    if(!rotulo) return null;
    for(const linha of linhas){
        if(Math.abs(linha.y - rotulo.y) > toleranciaY) continue;
        const candidatos = linha.itens
            .filter(it=>it.x > rotulo.x + 1)
            .filter(it=>/^R?\$?\s*[\d.,]+$/.test(it.text))
            .filter(it=>(it.x - rotulo.x) <= maxDistX)
            .sort((a,b)=>a.x - b.x);
        if(candidatos.length > 0) return candidatos[0].text;
    }
    return null;
}
function extrairNomeFuncionario(linhas, idxLinhaNome){
    const isNomeValido = (txt)=>{
        const n = normalizarNome(txt);
        if(n.length < 2) return false;
        if(ROTULOS_IGNORADOS_NOME.some(r=>n === r)) return false;
        if(/^\d/.test(n)) return false;
        if(!/^[A-Z]/.test(n)) return false;
        return true;
    };
    for(let off = 1; off <= 2; off++){
        const idx = idxLinhaNome + off;
        if(idx >= linhas.length) break;
        const linha = linhas[idx];
        const itens = linha.itens.filter(it=>it.x < 250).filter(it=>isNomeValido(it.text)).sort((a,b)=>a.x - b.x);
        if(itens.length > 0){
            let nome = itens.map(it=>it.text.trim()).join(' ').replace(/\s+/g,' ').trim();
            nome = nome.replace(/^\d+\s+/, '');
            if(nome.length >= 5) return nome;
        }
    }
    const linha = linhas[idxLinhaNome];
    if(linha){
        const itens = linha.itens.filter(it=>it.x < 250).filter(it=>isNomeValido(it.text)).sort((a,b)=>a.x - b.x);
        if(itens.length > 0){
            let nome = itens.map(it=>it.text.trim()).join(' ').replace(/\s+/g,' ').trim();
            nome = nome.replace(/^\d+\s+/, '');
            if(nome.length >= 5) return nome;
        }
    }
    return null;
}
function extrairINSS(linhas){
    const rot = acharRotulo(linhas, 'I.N.S.S.', 'INSS', 'I N S S');
    if(!rot) return null;
    const xDescontos = acharXColunaDescontos(linhas);
    for(const linha of linhas){
        if(Math.abs(linha.y - rot.y) > 4) continue;
        let nums = linha.itens.filter(it=>/^R?\$?\s*[\d.,]+$/.test(it.text)).sort((a,b)=>a.x - b.x);
        if(xDescontos !== null) nums = nums.filter(it=>it.x > xDescontos);
        if(nums.length === 0) return 0;
        return parseNumeroEstrito(nums[nums.length - 1].text);
    }
    return null;
}
function extrairIRRF(linhas){
    const rot = acharRotulo(linhas, 'I.R.R.F.', 'IRRF', 'I R R F', 'FAIXA IRRF');
    if(!rot) return null;
    const xDescontos = acharXColunaDescontos(linhas);
    for(const linha of linhas){
        if(Math.abs(linha.y - rot.y) > 4) continue;
        let nums = linha.itens.filter(it=>/^R?\$?\s*[\d.,]+$/.test(it.text)).sort((a,b)=>a.x - b.x);
        if(xDescontos !== null) nums = nums.filter(it=>it.x > xDescontos);
        if(nums.length > 0) return parseNumeroEstrito(nums[nums.length - 1].text);
        return 0;
    }
    return null;
}
function extrairTodosFuncionariosPorCoordenadas(paginas){
    const resultados = [];
    const vistos = new Set();
    for(const pag of paginas){
        const linhas = agruparItensEmLinhas(pag.items, 3.5);
        const linhasNome = [];
        for(let i = 0; i < linhas.length; i++){
            if(linhas[i].itens.some(it=>normalizarNome(it.text).includes('NOME DO FUNCIONARIO'))) linhasNome.push(i);
        }
        if(linhasNome.length === 0) continue;
        for(let b = 0; b < linhasNome.length; b++){
            const ini = linhasNome[b];
            const fim = (b + 1 < linhasNome.length) ? linhasNome[b + 1] : linhas.length;
            const blocoLinhas = linhas.slice(ini, fim);
            const nomePDF = extrairNomeFuncionario(linhas, ini);
            if(!nomePDF) continue;
            const dados = extrairFuncionarioBloco(blocoLinhas, nomePDF);
            if(!dados || !dados.nomePDF) continue;
            dados.paginaPDF = pag.numero || 1;
            const chave = normalizarNome(dados.nomePDF) + '|' + (dados.salarioBase || 0).toFixed(2) + '|' + (dados.vencimentos || 0).toFixed(2);
            if(vistos.has(chave)) continue;
            vistos.add(chave);
            resultados.push(dados);
        }
    }
    return resultados;
}
function extrairFuncionarioBloco(blocoLinhas, nomePDF){
    const dados = { nomePDF: nomePDF.trim(), funcionarioId:null, matchExato:false, salarioBase:null, vencimentos:null, descontos:null, liquido:null, baseINSS:null, inss:null, fgts:null, irrf:null, alerta:null };
    const rotSalario = acharRotulo(blocoLinhas, 'SALARIO BASE', 'SALÁRIO BASE');
    const rotBaseINSS = acharRotulo(blocoLinhas, 'SAL. CONTR. INSS', 'SAL CONTR INSS');
    const rotBaseFGTS = acharRotulo(blocoLinhas, 'BASE CALC. FGTS', 'BASE CÁLC. FGTS');
    const rotFGTS = acharRotulo(blocoLinhas, 'F.G.TS DO MES', 'F.G.T.S DO MÊS', 'FGTS DO MES');
    const vSalario = acharValorAbaixo(blocoLinhas, rotSalario, 90, 6);
    const vBaseINSS = acharValorAbaixo(blocoLinhas, rotBaseINSS, 90, 6);
    const vBaseFGTS = acharValorAbaixo(blocoLinhas, rotBaseFGTS, 90, 6);
    const vFGTS = acharValorAbaixo(blocoLinhas, rotFGTS, 90, 6);
    let salNum = parseNumeroEstrito(vSalario);
    const baseINSSNum = parseNumeroEstrito(vBaseINSS);
    const baseFGTSNum = parseNumeroEstrito(vBaseFGTS);
    if((salNum === null || salNum < 100) && baseINSSNum && baseINSSNum >= 100) salNum = baseINSSNum;
    else if((salNum === null || salNum < 100) && baseFGTSNum && baseFGTSNum >= 100) salNum = baseFGTSNum;
    dados.salarioBase = salNum;
    dados.baseINSS = baseINSSNum;
    dados.fgts = parseNumeroEstrito(vFGTS);

    const rotTotalVenc = acharRotulo(blocoLinhas, 'TOTAL DE VENCIMENTOS', 'TOTAL VENCIMENTOS');
    const rotTotalDesc = acharRotulo(blocoLinhas, 'TOTAL DE DESCONTOS', 'TOTAL DESCONTOS');
    let vVenc = acharValorNaLinha(blocoLinhas, rotTotalVenc, 4, 500);
    let vDesc = acharValorNaLinha(blocoLinhas, rotTotalDesc, 4, 500);
    if(!vVenc) vVenc = acharValorAbaixo(blocoLinhas, rotTotalVenc, 100, 4);
    if(!vDesc) vDesc = acharValorAbaixo(blocoLinhas, rotTotalDesc, 100, 4);
    dados.vencimentos = parseNumeroEstrito(vVenc);
    dados.descontos = parseNumeroEstrito(vDesc);

    const rotLiquido = acharRotulo(blocoLinhas, 'VALOR LIQUIDO', 'VALOR LÍQUIDO');
    let vLiquido = acharValorNaLinha(blocoLinhas, rotLiquido, 4, 400);
    if(!vLiquido) vLiquido = acharValorAbaixo(blocoLinhas, rotLiquido, 100, 4);
    dados.liquido = parseNumeroEstrito(vLiquido);

    dados.inss = extrairINSS(blocoLinhas);
    if(dados.inss === null && dados.baseINSS && dados.baseINSS > 0){
        dados.inss = calcularINSS(dados.baseINSS);
        dados.alerta = (dados.alerta ? dados.alerta + ' | ' : '') + `INSS não lido (Calc: ${dados.inss.toFixed(2)})`;
    }
    dados.irrf = extrairIRRF(blocoLinhas);
    if(dados.irrf === null) dados.irrf = 0;

    if(dados.vencimentos === null && dados.salarioBase !== null) dados.vencimentos = dados.salarioBase;
    if(dados.descontos === null) dados.descontos = dados.inss || 0;
    if(dados.liquido === null && dados.vencimentos !== null) dados.liquido = dados.vencimentos - (dados.descontos || 0);
    if(dados.baseINSS === null && dados.salarioBase !== null) dados.baseINSS = dados.salarioBase;
    if(dados.fgts === null && dados.salarioBase !== null && dados.salarioBase > 0){
        dados.fgts = calcularFGTS(dados.salarioBase);
        dados.alerta = (dados.alerta ? dados.alerta + ' | ' : '') + `FGTS não lido (Calc: ${dados.fgts.toFixed(2)})`;
    }
    return dados;
}
function extrairTodosFuncionarios(texto){
    const textoNorm = texto.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\s+/g,' ');
    const regexNomeFunc = /([A-Z][A-Z\s]{5,60}?)\s+NOME\s+DO\s+FUNCIONARIO/gi;
    const matches = [...textoNorm.matchAll(regexNomeFunc)];
    const nomesProcessados = [];
    const vistos = new Set();
    for(const match of matches){
        let nomeBruto = match[1].trim().replace(/^\d+\s+/, '').replace(/^CODIGO\s+/, '').replace(/^\d+\s+/, '');
        const nomeNorm = normalizarNome(nomeBruto);
        if(nomeNorm.length < 5) continue;
        if(ROTULOS_IGNORADOS_NOME.some(r=>nomeNorm === r)) continue;
        if(vistos.has(nomeNorm)) continue;
        vistos.add(nomeNorm);
        nomesProcessados.push({ nome:nomeBruto, nomeNorm, index:match.index });
    }
    const resultados = [];
    for(let i = 0; i < nomesProcessados.length; i++){
        const atual = nomesProcessados[i];
        const proximoIndex = (i + 1 < nomesProcessados.length) ? nomesProcessados[i + 1].index : textoNorm.length;
        const bloco = textoNorm.substring(atual.index, proximoIndex);
        const dados = extrairFuncionarioIndividualPorNome(bloco, atual.nome);
        if(dados && dados.nomePDF){
            dados.paginaPDF = 1;
            resultados.push(dados);
        }
    }
    return resultados;
}
function extrairFuncionarioIndividualPorNome(texto, nomeConhecido){
    const textoUm = texto.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\s+/g,' ');
    let nomeLimpo = nomeConhecido.replace(/^CODIGO\s+/i,'').replace(/^\d+\s+/i,'').trim();
    const dados = { nomePDF:nomeLimpo, funcionarioId:null, matchExato:false, salarioBase:null, vencimentos:null, descontos:null, liquido:null, baseINSS:null, inss:null, fgts:null, irrf:null, alerta:null };
    const mSal = textoUm.match(/([\d.,]+)\s+SALARIO\s+BASE/i);
    if(mSal) dados.salarioBase = parseNumeroEstrito(mSal[1]);
    const mBaseINSS = textoUm.match(/SAL\.?\s*CONTR\.?\s*INSS\s+([\d.,]+)/i);
    if(mBaseINSS) dados.baseINSS = parseNumeroEstrito(mBaseINSS[1]);
    const mFGTS = textoUm.match(/F\.?\s*G\.?\s*T\.?\s*S\s*DO\s*MES\s+([\d.,]+)/i);
    if(mFGTS) dados.fgts = parseNumeroEstrito(mFGTS[1]);
    const mVenc = textoUm.match(/TOTAL\s+DE\s+VENCIMENTOS\s+([\d.,]+)/i);
    if(mVenc) dados.vencimentos = parseNumeroEstrito(mVenc[1]);
    const mDesc = textoUm.match(/TOTAL\s+DE\s+DESCONTOS\s+([\d.,]+)/i);
    if(mDesc) dados.descontos = parseNumeroEstrito(mDesc[1]);
    const mLiq = textoUm.match(/VALOR\s+LIQUIDO\s+([\d.,]+)/i);
    if(mLiq) dados.liquido = parseNumeroEstrito(mLiq[1]);
    const mINSS = textoUm.match(/I\.?\s*N\.?\s*S\.?\s*S\.?\s*\.?\s+[\d,.]+\s+([\d.,]+)/i);
    if(mINSS) dados.inss = parseNumeroEstrito(mINSS[1]);
    if(dados.salarioBase && (!dados.vencimentos || dados.vencimentos < 100)) dados.vencimentos = dados.salarioBase;
    if(dados.inss === null && dados.baseINSS) dados.inss = calcularINSS(dados.baseINSS);
    if(dados.fgts === null && dados.salarioBase) dados.fgts = calcularFGTS(dados.salarioBase);
    if(dados.liquido === null && dados.vencimentos !== null) dados.liquido = dados.vencimentos - (dados.descontos || 0);
    if(dados.irrf === null) dados.irrf = 0;
    return dados;
}

/* ============================================================
   MATCH DE FUNCIONÁRIOS / PREVIEW
   ============================================================ */
function levenshtein(a, b){
    if(a.length === 0) return b.length;
    if(b.length === 0) return a.length;
    const matrix = [];
    for(let i = 0; i <= b.length; i++) matrix[i] = [i];
    for(let j = 0; j <= a.length; j++) matrix[0][j] = j;
    for(let i = 1; i <= b.length; i++){
        for(let j = 1; j <= a.length; j++){
            if(b.charAt(i-1) === a.charAt(j-1)) matrix[i][j] = matrix[i-1][j-1];
            else matrix[i][j] = Math.min(matrix[i-1][j-1] + 1, matrix[i][j-1] + 1, matrix[i-1][j] + 1);
        }
    }
    return matrix[b.length][a.length];
}
function calcularSimilaridade(nome1, nome2){
    const n1 = normalizarNome(nome1);
    const n2 = normalizarNome(nome2);
    if(!n1 || !n2) return 0;
    if(n1 === n2) return 100;
    const dist = levenshtein(n1, n2);
    const maxLen = Math.max(n1.length, n2.length);
    const sim = Math.round((1 - dist / maxLen) * 100);
    const palavras1 = n1.split(/\s+/).filter(Boolean);
    const palavras2 = n2.split(/\s+/).filter(Boolean);
    let comuns = 0;
    palavras1.forEach(p=>{ if(p.length > 2 && palavras2.includes(p)) comuns++; });
    const bonus = comuns > 0 ? Math.min(comuns * 5, 15) : 0;
    return Math.min(sim + bonus, 100);
}
function buscarSugestoesSimilares(nomePDF, limite = 5){
    if(!nomePDF || !funcionarios.length) return [];
    return funcionarios
        .filter(f=>!f.desligamento)
        .map(f=>({ funcionario:f, similaridade:calcularSimilaridade(nomePDF, f.nome) }))
        .filter(s=>s.similaridade >= 30)
        .sort((a,b)=>b.similaridade - a.similaridade)
        .slice(0, limite);
}
function tentarMatchExato(nomePDF){
    const alvo = normalizarNome(nomePDF);
    if(!alvo) return null;
    const exato = funcionarios.find(f=>normalizarNome(f.nome) === alvo);
    if(exato) return exato;
    const partes = alvo.split(/\s+/).filter(Boolean);
    if(partes.length >= 2){
        const primeiro = partes[0], ultimo = partes[partes.length-1];
        const candidatos = funcionarios.filter(f=>{
            const n = normalizarNome(f.nome);
            return n.includes(primeiro) && n.includes(ultimo);
        });
        if(candidatos.length === 1) return candidatos[0];
    }
    return null;
}
