function extrairColunaAusente(error){
    if(!error) return null;
    const msg = error.message || '';
    let m = msg.match(/column\s+(?:[a-zA-Z0-9_]+\.)?["']?([a-zA-Z0-9_]+)["']?\s+does not exist/i);
    if(m) return m[1];
    m = msg.match(/Could not find the '([^']+)' column/i);
    if(m) return m[1];
    m = msg.match(/column\s+["']([^"']+)["']/i);
    if(m) return m[1];
    return null;
}
async function salvarComFallback(tabela, operacao, payloadInicial){
    if(!_colunasAusentes[tabela]) _colunasAusentes[tabela] = new Set();
    const ignoradas = _colunasAusentes[tabela];
    const payload = { ...payloadInicial };
    for(const coluna of ignoradas){
        delete payload[coluna];
    }
    let ultimoErro = null;
    for(let tent = 0; tent < 24; tent++){
        const { data, error } = await operacao(payload);
        if(!error) return { ok:true, data };
        ultimoErro = error;
        const coluna = extrairColunaAusente(error);
        if(coluna && Object.prototype.hasOwnProperty.call(payload, coluna)){
            console.warn(`[${tabela}] Coluna "${coluna}" não existe. Removendo do payload e tentando novamente.`);
            ignoradas.add(coluna);
            delete payload[coluna];
            continue;
        }
        return { ok:false, error };
    }
    return { ok:false, error: ultimoErro };
}

/* ============================================================
   DIRETÓRIO DE COLABORADORES
   ------------------------------------------------------------
   O projeto novo não possui a tabela "funcionarios". O diretório
   é montado a partir dos contracheques já existentes. Se a tabela
   "funcionarios" existir no futuro, ela é usada automaticamente.
   ============================================================ */
async function carregarFuncionarios(){
    try{
        const { data, error } = await db.from('funcionarios').select('*').order('nome');
        if(!error && data && data.length > 0){
            funcionarios = data;
            return funcionarios;
        }
        if(error && error.code !== 'PGRST205' && error.code !== '42P01'){
            console.warn('Tabela funcionarios indisponível no projeto novo:', error.message);
        }
    }catch(e){
        console.warn('Tabela funcionarios indisponível no projeto novo:', e);
    }

    // Diretório oficial do sistema antigo (é de lá que vêm as sugestões do pop-up)
    try{
        const { data, error } = await dbLegacy.from('funcionarios').select('*').order('nome');
        if(!error && data && data.length > 0){
            funcionarios = data.map(f=>({
                ...f,
                desligamento: f.desligamento || f.demissao || null
            }));
            return funcionarios;
        }
        if(error) console.warn('Base antiga de funcionarios indisponível:', error.message);
    }catch(e){
        console.warn('Base antiga de funcionarios indisponível:', e);
    }

    // Último fallback: nomes que já existem no histórico de contracheques
    const { data, error } = await db
        .from('contracheques')
        .select('funcionario_id, funcionario_nome, unidade, departamento, cargo, salario_base, updated_at')
        .order('updated_at', { ascending:false })
        .limit(5000);
    if(error) throw error;

    const mapa = new Map();
    for(const r of data || []){
        const nome = (r.funcionario_nome || '').trim();
        const chave = normalizarNome(nome);
        if(!chave) continue;
        if(!mapa.has(chave)){
            mapa.set(chave, {
                id: r.funcionario_id || null,
                nome,
                unidade: r.unidade || null,
                departamento: r.departamento || null,
                cargo: r.cargo || null,
                salario: Number(r.salario_base) || 0
            });
        }else if(!mapa.get(chave).id && r.funcionario_id){
            mapa.get(chave).id = r.funcionario_id;
        }
    }
    funcionarios = [...mapa.values()].sort((a,b)=>(a.nome || '').localeCompare(b.nome || ''));
    return funcionarios;
}
