function numeroDoCampo(v){
    if(v === '' || v === null || v === undefined) return null;
    const n = parseFloat(String(v).replace(',', '.'));
    return isNaN(n) ? null : n;
}
function sanitizarNomeArquivo(nome){
    return String(nome || 'contracheque.pdf')
        .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
        .replace(/[^a-zA-Z0-9._-]/g,'_')
        .replace(/_+/g,'_')
        .slice(-120);
}
async function confirmarValidacaoCC(){
    if(_salvandoCC) return;
    salvarEdicoesValidacaoCCAtual();

    const comNome = _validacaoCCData
        .map(r=>({ ...r, nome:(r.nomeEditavel || r.nomePDF || '').trim() }))
        .filter(r=>r.nome);
    const semNome = _validacaoCCData.length - comNome.length;

    if(comNome.length === 0){
        mostrarToast('⚠️ Informe o nome do colaborador em pelo menos um registro.', 'warning');
        return;
    }
    if(semNome > 0){
        const confirmar = confirm(
            `⚠️ ${semNome} de ${_validacaoCCData.length} registro(s) estão sem nome e serão IGNORADOS.\n\n` +
            `Deseja salvar os ${comNome.length} registros nomeados?`
        );
        if(!confirmar) return;
    }

    const normalizado = comNome.map(r=>({
        ...r,
        salarioBase: numeroDoCampo(r.editSalarioBase),
        vencimentos: numeroDoCampo(r.editVencimentos),
        descontos: numeroDoCampo(r.editDescontos),
        liquido: numeroDoCampo(r.editLiquido),
        baseINSS: numeroDoCampo(r.editBaseINSS),
        inss: numeroDoCampo(r.editINSS),
        fgts: numeroDoCampo(r.editFGTS),
        irrf: numeroDoCampo(r.editIRRF)
    }));

    // Evita salvar duas vezes o mesmo colaborador no mesmo PDF
    const vistos = new Set();
    const unicos = [];
    const avisos = [];
    for(const r of normalizado){
        const chave = normalizarNome(r.nome);
        if(vistos.has(chave)){
            avisos.push(`${r.nome}: nome repetido no PDF, registro duplicado ignorado`);
            continue;
        }
        vistos.add(chave);
        unicos.push(r);
    }

    const mes = _importContextMes || (parseInt(document.getElementById('ccMes').value,10) + 1);
    const ano = _importContextAno || (parseInt(document.getElementById('ccAno').value,10) || new Date().getFullYear());
    const mn = MESES[mes-1];

    const btn = document.getElementById('btnSalvarValidacao');
    if(btn){ btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...'; }
    _salvandoCC = true;

    abrirProgresso('Salvando contracheques', `Gravando ${unicos.length} registro(s) de ${mn}/${ano}...`);
    atualizarProgresso(10, 'Preparando arquivo...');

    let salvos = 0, atualizados = 0;
    const erros = [];
    let avisoPdf = null;

    try{
        const existentesPorNome = new Map();
        const existentesPorId = new Map();
        const { data: existentes, error: errExistentes } = await db
            .from('contracheques')
            .select('id, funcionario_id, funcionario_nome, dados_brutos')
            .eq('mes_referencia', mes)
            .eq('ano_referencia', ano);
        if(errExistentes) throw new Error(`Falha ao consultar registros existentes: ${errExistentes.message}`);
        for(const e of existentes || []){
            const chave = normalizarNome(e.funcionario_nome);
            if(chave && !existentesPorNome.has(chave)) existentesPorNome.set(chave, e);
            if(e.funcionario_id && !existentesPorId.has(String(e.funcionario_id))) existentesPorId.set(String(e.funcionario_id), e);
        }

        let arquivoBase64 = '';
        try{
            arquivoBase64 = obterPdfBase64();
        }catch(eBase){
            console.warn('Falha ao converter PDF para base64:', eBase);
            avisoPdf = 'Não foi possível anexar o PDF (arquivo muito grande). Os dados foram salvos sem o arquivo.';
        }

        atualizarProgresso(18, 'Gravando registros...');

        for(let i = 0; i < unicos.length; i++){
            const r = unicos[i];
            try{
            const chaveNome = normalizarNome(r.nome);
            const diretorio = funcionarios.find(f=>normalizarNome(f.nome) === chaveNome) || null;
            let existente = existentesPorId.get(String(r.funcionarioId)) || existentesPorNome.get(chaveNome) || null;

            let fid = (existente && existente.funcionario_id) || r.funcionarioId || (diretorio && diretorio.id) || gerarUUID();
            const dadosAntigos = existente ? lerDadosBrutos(existente) : {};
            const dadosBrutos = {
                ...dadosAntigos,
                nomePDF: r.nomePDF || r.nome,
                paginaPDF: r.paginaPDF || 1
            };

            const payload = {
                funcionario_id: fid,
                funcionario_nome: r.nome,
                funcionario_matricula: diretorio?.matricula || null,
                empresa: diretorio?.empresa || null,
                unidade: diretorio?.unidade || null,
                departamento: diretorio?.departamento || null,
                cbo: null,
                cargo: diretorio?.cargo || null,
                data_admissao: diretorio?.admissao || null,
                data_pagamento: null,
                salario_base: r.salarioBase ?? 0,
                total_proventos: r.vencimentos ?? 0,
                total_descontos: r.descontos ?? 0,
                valor_liquido: r.liquido ?? 0,
                base_calc_inss: r.baseINSS ?? 0,
                base_calc_fgts: r.salarioBase ?? 0,
                fgts_mes: r.fgts ?? 0,
                base_calc_irrf: 0,
                faixa_irrf: r.irrf ?? 0,
                mes_referencia: mes,
                ano_referencia: ano,
                status: 'concluido',
                inconsistencias: [],
                dados_brutos: dadosBrutos,
                importado_por: usuarioAtual?.nome || 'sistema',
                arquivo_hash: `IMP_${fid}_${mes}_${ano}_${Date.now()}_${i}`
            };

            if(arquivoBase64){
                payload.arquivo_base64 = arquivoBase64;
                payload.arquivo_nome = _pdfArquivoNome || `import_${r.nome}_${mes}_${ano}.pdf`;
            }else if(!existente){
                payload.arquivo_nome = null;
            }

            const idExistente = existente && existente.id ? existente.id : null;
            const operacao = (p)=>{
                if(idExistente) return db.from('contracheques').update(p).eq('id', idExistente);
                return db.from('contracheques').insert(p);
            };
            const resp = await salvarComFallback('contracheques', operacao, payload);
            if(!resp.ok) throw resp.error;

            if(idExistente) atualizados++; else salvos++;
            existentesPorNome.set(chaveNome, {
                id: idExistente,
                funcionario_id: fid,
                funcionario_nome: r.nome,
                dados_brutos: dadosBrutos
            });
            existentesPorId.set(String(fid), {
                id: idExistente,
                funcionario_id: fid,
                funcionario_nome: r.nome,
                dados_brutos: dadosBrutos
            });
            }catch(eReg){
                console.error(`Erro ao salvar "${r.nome}":`, eReg);
                const msgErro = mensagemErroBanco(eReg);
                erros.push(`${r.nome}: ${msgErro}`);
                if(/Sem permissão de gravação \(RLS\)/i.test(msgErro)) break;
            }
            const pct = 18 + Math.round(((i + 1) / unicos.length) * 80);
            atualizarProgresso(pct, `Salvando ${i + 1} de ${unicos.length}...`);
        }
    }catch(e){
        console.error('Erro no salvamento dos contracheques:', e);
        erros.push(mensagemErroBanco(e));
    }finally{
        if(btn){ btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Confirmar e Salvar Todos'; }
        _salvandoCC = false;
        fecharProgresso();
    }

    const totalGravados = salvos + atualizados;

    if(totalGravados > 0 && erros.length === 0){
        fecharValidacaoCC();
        fecharModalImportacao();
    }

    if(erros.length === 0){
        mostrarToast(`✅ ${totalGravados} contracheque(s) salvos para ${mn}/${ano}.`, '');
    }else{
        mostrarToast(`⚠️ ${totalGravados} salvo(s), ${erros.length} erro(s).`, 'warning');
        const textoAlerta =
            `⚠️ ${totalGravados > 0 ? 'Salvamento parcial' : 'Nenhum registro salvo'}\n\n` +
            `✅ Salvos/atualizados: ${totalGravados}\n` +
            `❌ Erros: ${erros.length}\n\n` +
            `Detalhes:\n` + erros.map(e=>`• ${e}`).join('\n') +
            (avisos.length ? `\n\nAvisos:\n` + avisos.map(e=>`• ${e}`).join('\n') : '') +
            (avisoPdf ? `\n\nPDF: ${avisoPdf}` : '');
        setTimeout(()=>alert(textoAlerta), 150);
    }
    if(avisoPdf && totalGravados > 0) mostrarToast(`⚠️ ${avisoPdf}`, 'warning');

    try{ await carregarFuncionarios(); }catch(e){ console.warn(e); }
    try{ if(_competenciaConfirmada) await carregarPainelImportacao(); }catch(e){ console.warn(e); }
    try{
        document.getElementById('verMes').value = String(mes - 1);
        document.getElementById('verAno').value = ano;
        await carregarVerContracheques();
    }catch(e){ console.warn(e); }
}

/* ============================================================
   CONSOLIDADOR PDF
   ============================================================ */
function getPdfLib(){
    if(typeof PDFLib !== 'undefined') return PDFLib;
    if(typeof pdfLib !== 'undefined') return pdfLib;
    if(window.PDFLib) return window.PDFLib;
    return null;
}
function consImportar(){
    const inp = document.getElementById('consFileInput');
    if(!inp) return;
    inp.value = '';
    inp.click();
}
function consSetStatus(tipo, html){
    const s = document.getElementById('consStatus');
    if(!s) return;
    s.className = 'cons-status ' + (tipo === 'ok' ? 'ok' : tipo === 'warn' ? 'warn' : tipo === 'err' ? 'err' : 'info');
    const ic = tipo === 'ok' ? 'check-circle' : tipo === 'warn' ? 'exclamation-triangle' : tipo === 'err' ? 'times-circle' : 'info-circle';
    s.innerHTML = `<i class="fas fa-${ic}"></i><span>${html}</span>`;
}
async function consProcessar(files){
    if(!files || files.length === 0) return;
    consSetStatus('info', `<i class="fas fa-spinner fa-spin"></i> Processando ${files.length} arquivo(s)...`);
    let total = 0;
    const erros = [];

    for(const file of files){
        try{
            const buf = await file.arrayBuffer();
            const bytes = new Uint8Array(buf);
            const chave = file.name + '::' + bytes.length + '::' + file.lastModified;
            _consBytesCache[chave] = bytes;

            const pdf = await pdfjsLib.getDocument({ data: bytes.slice(0) }).promise;
            for(let p = 1; p <= pdf.numPages; p++){
                const page = await pdf.getPage(p);
                const vp = page.getViewport({ scale: 0.4 });
                const canvas = document.createElement('canvas');
                canvas.width = vp.width;
                canvas.height = vp.height;
                await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
                const thumb = canvas.toDataURL('image/jpeg', 0.6);
                _consPaginas.push({
                    id: ++_consIdSeq,
                    nome: file.name,
                    pagina: p,
                    totalPag: pdf.numPages,
                    chaveBytes: chave,
                    removida: false,
                    thumb
                });
                total++;
            }
        }catch(e){
            console.error('Erro ao processar PDF:', file.name, e);
            erros.push(`${file.name}: ${e.message || e}`);
        }
    }

    consRenderLista();
    consAtualizarBotoes();
    _consConsolidado = null;
    document.getElementById('consAviso').classList.remove('active');

    if(erros.length > 0){
        consSetStatus('warn', `⚠️ ${total} página(s) adicionadas. ${erros.length} erro(s).`);
    }else{
        consSetStatus('ok', `✅ ${total} página(s) de ${files.length} arquivo(s) importadas.`);
    }
    if(total > 0){
        const first = _consPaginas.findIndex(p=>!p.removida);
        if(first >= 0) consSelecionar(first);
    }
}
function consRenderLista(){
    const lista = document.getElementById('consLista');
    const contador = document.getElementById('consContador');
    if(!lista) return;
    if(contador) contador.textContent = String(_consPaginas.length);
    if(_consPaginas.length === 0){
        lista.innerHTML = `<div class="empty-state" style="padding:40px 14px;"><i class="fas fa-inbox"></i><p>Importe PDFs para começar.</p></div>`;
        return;
    }
    lista.innerHTML = _consPaginas.map((p, i)=>{
        const sel = i === _consSelIdx ? 'selected' : '';
        const rem = p.removida ? 'removida' : '';
        return `<div class="cons-lista-item ${sel} ${rem}" data-idx="${i}" onclick="consSelecionar(${i})">
            <img class="cons-thumb" src="${p.thumb}" alt="pág ${p.pagina}">
            <div class="cons-info">
                <span class="nome" title="${escaparHTML(p.nome)}">${escaparHTML(p.nome)}</span>
                <span class="pag">Página ${p.pagina} / ${p.totalPag}</span>
            </div>
            ${p.removida
                ? `<button type="button" class="cons-mini green" onclick="event.stopPropagation();consRestaurarPagina(${i})" title="Restaurar"><i class="fas fa-undo"></i></button>`
                : `<button type="button" class="cons-mini red" onclick="event.stopPropagation();consRemoverPagina(${i})" title="Remover"><i class="fas fa-trash"></i></button>`
            }
        </div>`;
    }).join('');
}
function consSelecionar(idx){
    if(idx < 0 || idx >= _consPaginas.length) return;
    _consSelIdx = idx;
    consRenderLista();
    consRenderPreview(idx);
}
async function consRenderPreview(idx){
    const viewer = document.getElementById('consViewer');
    const p = _consPaginas[idx];
    if(!viewer) return;
    if(!p){
        viewer.innerHTML = `<div class="placeholder"><i class="fas fa-file-pdf"></i>Selecione uma página.</div>`;
        return;
    }
    viewer.innerHTML = `<div class="placeholder"><i class="fas fa-spinner fa-spin"></i>Renderizando ${escaparHTML(p.nome)} — pág ${p.pagina}...</div>`;
    try{
        const bytes = _consBytesCache[p.chaveBytes];
        const pdf = await pdfjsLib.getDocument({ data: bytes.slice(0) }).promise;
        const page = await pdf.getPage(p.pagina);
        const vp = page.getViewport({ scale: 1.45 });
        const canvas = document.createElement('canvas');
        canvas.width = vp.width;
        canvas.height = vp.height;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
        viewer.innerHTML = '';
        viewer.appendChild(canvas);
        const bar = document.createElement('div');
        bar.className = 'viewer-bar';
        bar.textContent = `${p.nome} — Página ${p.pagina} de ${p.totalPag}`;
        viewer.appendChild(bar);
    }catch(e){
        console.error(e);
        viewer.innerHTML = `<div class="placeholder"><i class="fas fa-exclamation-triangle" style="color:#ff8a8a;"></i>Erro ao renderizar.<small>${escaparHTML(e.message || e)}</small></div>`;
    }
}
function consRemoverPagina(idx){
    if(!_consPaginas[idx]) return;
    _consPaginas[idx].removida = true;
    consRenderLista();
    consAtualizarBotoes();
    _consConsolidado = null;
    document.getElementById('consAviso').classList.remove('active');
}
function consRestaurarPagina(idx){
    if(!_consPaginas[idx]) return;
    _consPaginas[idx].removida = false;
    consRenderLista();
    consAtualizarBotoes();
    _consConsolidado = null;
    document.getElementById('consAviso').classList.remove('active');
}
function consRemoverTodas(){
    if(_consPaginas.length === 0) return;
    if(!confirm('Marcar TODAS as páginas para remoção?')) return;
    _consPaginas.forEach(p=>p.removida = true);
    consRenderLista();
    consAtualizarBotoes();
}
function consRestaurarTodas(){
    if(_consPaginas.length === 0) return;
    _consPaginas.forEach(p=>p.removida = false);
    consRenderLista();
    consAtualizarBotoes();
    _consConsolidado = null;
    document.getElementById('consAviso').classList.remove('active');
}
function consLimpar(){
    if(_consPaginas.length === 0 && !_consConsolidado){
        mostrarToast('⚠️ Nada para limpar.', 'warning');
        return;
    }
    if(!confirm('Limpar TODOS os PDFs importados e o consolidado gerado?')) return;
    _consPaginas = [];
    _consSelIdx = -1;
    _consConsolidado = null;
    _consTotalPag = 0;
    _consIdSeq = 0;
    _consBytesCache = {};
    document.getElementById('consLista').innerHTML = `<div class="empty-state" style="padding:40px 14px;"><i class="fas fa-inbox"></i><p>Importe PDFs para começar.</p></div>`;
    document.getElementById('consViewer').innerHTML = `<div class="placeholder"><i class="fas fa-file-pdf"></i>Selecione uma página à esquerda.</div>`;
    document.getElementById('consContador').textContent = '0';
    document.getElementById('consAviso').classList.remove('active');
    consSetStatus('info', 'Nenhum PDF importado. Clique em <strong>Importar PDFs</strong> para começar.');
    consAtualizarBotoes();
    mostrarToast('🧹 Tudo limpo.', 'info');
}
function consAtualizarBotoes(){
    const selecionadas = _consPaginas.filter(p=>!p.removida);
    const btnConsolidar = document.getElementById('btnConsolidar');
    const btnExportar = document.getElementById('btnExportarConsolidado');
    if(btnConsolidar) btnConsolidar.disabled = selecionadas.length === 0;
    if(btnExportar) btnExportar.disabled = !_consConsolidado;
}
async function consConsolidar(){
    const selecionadas = _consPaginas.filter(p=>!p.removida);
    if(selecionadas.length === 0){
        mostrarToast('⚠️ Nenhuma página selecionada para consolidar.', 'warning');
        return;
    }
    const pdfLib = getPdfLib();
    if(!pdfLib){
        mostrarToast('❌ Biblioteca pdf-lib não carregada. Verifique a conexão.', 'error');
        return;
    }
    const btn = document.getElementById('btnConsolidar');
    if(btn){ btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Consolidando...'; }

    const total = selecionadas.length;
    const erros = [];
    const cacheDocs = {};

    try{
        const pdfFinal = await pdfLib.PDFDocument.create();
        for(let i = 0; i < total; i++){
            const p = selecionadas[i];
            consSetStatus('info', `<i class="fas fa-spinner fa-spin"></i> Consolidando ${i+1}/${total}...`);
            try{
                const bytes = _consBytesCache[p.chaveBytes];
                if(!bytes) throw new Error('bytes indisponíveis');
                let docOrigem = cacheDocs[p.chaveBytes];
                if(!docOrigem){
                    docOrigem = await pdfLib.PDFDocument.load(bytes);
                    cacheDocs[p.chaveBytes] = docOrigem;
                }
                const totalPag = docOrigem.getPageCount();
                if(p.pagina < 1 || p.pagina > totalPag) throw new Error(`página ${p.pagina} fora do intervalo (${totalPag})`);
                const [pagCopiada] = await pdfFinal.copyPages(docOrigem, [p.pagina - 1]);
                pdfFinal.addPage(pagCopiada);
            }catch(errPag){
                console.warn(`Página ${p.pagina} de "${p.nome}" ignorada:`, errPag.message);
                erros.push(`${p.nome} pág ${p.pagina}: ${errPag.message}`);
            }
        }
        const processadas = total - erros.length;
        if(processadas === 0) throw new Error('Nenhuma página pôde ser consolidada.');

        _consConsolidado = await pdfFinal.save();
        _consTotalPag = processadas;
        const arquivosUnicos = new Set(selecionadas.map(p=>p.nome)).size;
        document.getElementById('consTexto').textContent =
            ` ${processadas} página(s) de ${arquivosUnicos} arquivo(s) — ${(_consConsolidado.length/1024).toFixed(1)} KB` +
            (erros.length ? ` (⚠️ ${erros.length} ignorada(s))` : '');
        document.getElementById('consAviso').classList.add('active');
        consSetStatus(
            erros.length ? 'warn' : 'ok',
            erros.length
                ? `⚠️ Consolidado gerado com <strong>${processadas}</strong> página(s). ${erros.length} ignorada(s).`
                : `✅ Consolidado gerado com <strong>${processadas}</strong> página(s).`
        );
        mostrarToast(`✅ PDF consolidado (${processadas} páginas).`, erros.length ? 'warning' : '');
    }catch(e){
        console.error('Erro ao consolidar:', e);
        consSetStatus('err', `❌ Erro ao consolidar: ${escaparHTML(e.message || e)}`);
        mostrarToast('❌ Erro: ' + (e.message || e), 'error');
    }finally{
        if(btn){ btn.disabled = false; btn.innerHTML = '<i class="fas fa-layer-group"></i> Consolidar'; }
        consAtualizarBotoes();
    }
}
async function consVisualizar(){
    if(!_consConsolidado){
        mostrarToast('⚠️ Gere o consolidado primeiro.', 'warning');
        return;
    }
    const modal = document.getElementById('modalConsolidadoView');
    const viewer = document.getElementById('consolidadoViewer');
    const info = document.getElementById('consolidadoInfo');
    if(!modal || !viewer) return;
    if(info) info.textContent = `${_consTotalPag} página(s)`;
    viewer.innerHTML = `<div class="placeholder"><i class="fas fa-spinner fa-spin"></i>Renderizando consolidado...</div>`;
    modal.classList.add('active');
    try{
        const pdf = await pdfjsLib.getDocument({ data: _consConsolidado.slice(0) }).promise;
        viewer.innerHTML = '';
        for(let i = 1; i <= pdf.numPages; i++){
            const page = await pdf.getPage(i);
            const vp = page.getViewport({ scale: 1.35 });
            const canvas = document.createElement('canvas');
            canvas.width = vp.width;
            canvas.height = vp.height;
            canvas.style.maxWidth = '100%';
            canvas.style.height = 'auto';
            await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
            viewer.appendChild(canvas);
            const lbl = document.createElement('div');
            lbl.className = 'viewer-bar';
            lbl.textContent = `Página ${i} de ${pdf.numPages}`;
            viewer.appendChild(lbl);
        }
    }catch(e){
        console.error('Erro ao visualizar consolidado:', e);
        viewer.innerHTML = `<div class="placeholder"><i class="fas fa-exclamation-triangle" style="color:#ff8a8a;"></i>Erro: ${escaparHTML(e.message || e)}</div>`;
    }
}
function fecharConsolidadoView(){
    document.getElementById('modalConsolidadoView').classList.remove('active');
}
function consExportar(){
    if(!_consConsolidado){
        mostrarToast('⚠️ Gere o consolidado primeiro.', 'warning');
        return;
    }
    try{
        const blob = new Blob([_consConsolidado], { type:'application/pdf' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const ts = new Date().toISOString().slice(0,19).replace(/[T:]/g,'-');
        a.href = url;
        a.download = `consolidado_contracheques_${ts}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(()=>URL.revokeObjectURL(url), 3000);
        mostrarToast(`✅ PDF exportado (${_consTotalPag} páginas).`, '');
    }catch(e){
        console.error('Erro ao exportar:', e);
        mostrarToast('❌ Erro ao exportar: ' + (e.message || e), 'error');
    }
}

