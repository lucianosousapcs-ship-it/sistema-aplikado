];
const TETO_INSS = 8157.41;
function calcularINSS(salario){
    if(!salario || salario <= 0) return 0;
    let base = Math.min(salario, TETO_INSS), inss = 0, anterior = 0;
    for(const f of FAIXAS_INSS){
        if(base > f.ate){ inss += (f.ate - anterior) * f.aliq; anterior = f.ate; }
        else { inss += (base - anterior) * f.aliq; break; }
    }
    return Math.round(inss * 100) / 100;
}
function calcularFGTS(salario){
    if(!salario || salario <= 0) return 0;
