async function processarPDFImportacao(){
    const input = document.getElementById('importFileInput');
    const file = input && input.files ? input.files[0] : null;
    if(!file){
        mostrarToast('⚠️ Selecione um arquivo PDF primeiro.', 'warning');
        return;
    }
    mostrarStatusImport('info', '<i class="fas fa-spinner fa-spin"></i> Lendo PDF e extraindo coordenadas X/Y...');
    const btnExtrair = document.getElementById('btnExtrairPDF');
    if(btnExtrair) btnExtrair.disabled = true;

    try{
        const arrayBuffer = await file.arrayBuffer();
        _pdfBytesAtual = new Uint8Array(arrayBuffer);
        _pdfArquivoNome = file.name;

        try{
            const pdfView = await pdfjsLib.getDocument({ data: _pdfBytesAtual.slice(0) }).promise;
            _pdfDocAtual = pdfView;
            await renderizarPdfViewer(pdfView);
        }catch(eView){
            console.warn('Erro ao renderizar preview do PDF:', eView);
        }

        const pdf = await pdfjsLib.getDocument({ data: _pdfBytesAtual.slice(0) }).promise;
        const paginas = [];
        for(let i = 1; i <= pdf.numPages; i++){
            const page = await pdf.getPage(i);
            const textContent = await page.getTextContent();
            paginas.push({ numero: i, items: textContent.items });
        }

        let dadosExtraidos = extrairTodosFuncionariosPorCoordenadas(paginas);
        if(!dadosExtraidos || dadosExtraidos.length === 0){
            let fullText = '';
            for(let i = 1; i <= pdf.numPages; i++){
                const page = await pdf.getPage(i);
                const tc = await page.getTextContent();
                fullText += tc.items.map(it=>it.str).join(' ') + '\n';
            }
            dadosExtraidos = extrairTodosFuncionarios(fullText);
        }
        if(!dadosExtraidos || dadosExtraidos.length === 0){
            throw new Error('Não foi possível identificar dados no PDF.');
        }

        _nomesPendentes = [];
        _importPreviewData = dadosExtraidos.map(d=>{
            const uid = `imp_${++_importUidSeq}`;
            const match = tentarMatchExato(d.nomePDF);
            if(!match){
                _nomesPendentes.push({
                    uid,
                    nomePDF: d.nomePDF,
                    nomeEditavel: d.nomePDF,
                    dados: d,
                    sugestoes: buscarSugestoesSimilares(d.nomePDF)
                });
            }
            return {
                ...d,
                _uid: uid,
                funcionarioId: match && match.id ? match.id : null,
                matchExato: !!match,
                sugestaoNome: match ? match.nome : null,
                nomeEditavel: match ? match.nome : (d.nomePDF || '')
            };
        });

        const comMatch = _importPreviewData.filter(x=>x.matchExato).length;
        const semMatch = _importPreviewData.length - comMatch;
        renderizarPreviewImportacao(_importPreviewData);

        if(semMatch === 0){
            mostrarStatusImport('ok', `✅ <strong>${comMatch}</strong> colaborador(es) reconhecido(s) na base. Revise os valores e clique em <strong>Validar e Salvar</strong>.`);
        }else{
            mostrarStatusImport('warn', `⚠️ <strong>${comMatch}</strong> reconhecido(s) e <strong>${semMatch}</strong> não vinculado(s). Abrindo a tela de vínculo...`);
            setTimeout(()=>abrirNomesPendentes(), 450);
        }
    }catch(error){
        console.error('Erro ao processar PDF:', error);
        mostrarStatusImport('err', `Erro: ${escaparHTML(error.message || error)}`);
        mostrarToast('❌ Erro ao ler PDF: ' + (error.message || error), 'error');
    }finally{
        if(btnExtrair){ btnExtrair.disabled = false; }
    }
}
async function renderizarPdfViewer(pdf){
    const viewer = document.getElementById('pdfViewerBody');
    const pageInfo = document.getElementById('pdfPageInfo');
    if(!viewer) return;
    viewer.innerHTML = '';
    if(pageInfo) pageInfo.textContent = `${pdf.numPages} página(s)`;
    for(let i = 1; i <= pdf.numPages; i++){
        const page = await pdf.getPage(i);
        const viewport = page.getViewport({ scale: 1.35 });
        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        canvas.style.maxWidth = '100%';
        canvas.style.height = 'auto';
        await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
        viewer.appendChild(canvas);
    }
}

