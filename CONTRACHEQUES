<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
<title>Contracheques | ApliKado</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --orange:#FF8C00;
  --orange-dark:#e07000;
  --purple:#6f42c1;
  --purple-dark:#4a1d96;
  --ink:#1a0a00;
  --muted:#7a3a00;
}
body{background:linear-gradient(135deg,#ffe0b0 0%,#ffb84d 30%,#FF8C00 60%,#e07000 100%);font-family:'Poppins',sans-serif;color:var(--ink);min-height:100vh;padding-bottom:40px}

/* ================= HEADER ================= */
.main-header{position:fixed;top:0;left:0;width:100%;background:rgba(10,6,2,.95);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,140,0,.15);z-index:1000;padding:4px 14px;display:flex;justify-content:space-between;align-items:center;height:46px;gap:10px}
.logo{font-size:16px;font-weight:800;color:#fff;flex-shrink:0;letter-spacing:-.3px}
.logo span{color:var(--orange)}
.nav-menu{display:flex;align-items:center;gap:4px;min-width:0}
.nav-menu a{color:rgba(255,255,255,.75);text-decoration:none;font-size:10.5px;font-weight:500;padding:5px 10px;border-radius:6px;display:flex;align-items:center;gap:5px;cursor:pointer;transition:all .3s;white-space:nowrap;flex-shrink:0}
.nav-menu a:hover{color:#fff;background:rgba(255,140,0,.15)}
.nav-menu a i{font-size:10px}
.user-info{display:flex;align-items:center;gap:7px;color:#fff;font-size:10.5px;background:rgba(255,255,255,.1);padding:3px 10px;border-radius:16px;white-space:nowrap;flex-shrink:0}
.user-info .user-role{background:var(--orange);padding:1px 6px;border-radius:8px;font-size:8px;font-weight:800;text-transform:uppercase;flex-shrink:0}

/* ================= LAYOUT ================= */
.container{max-width:1800px;margin:0 auto;padding:60px 16px 24px;display:flex;flex-direction:column;gap:16px}
.page-title{text-align:center;margin-bottom:2px}
.page-title h1{font-size:26px;font-weight:800;color:var(--ink)}
.page-title h1 i{color:var(--orange);margin-right:10px}
.page-subtitle{font-size:12px;color:#6b3200;font-weight:500;margin-top:4px}

.exec-container{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.18);display:flex;flex-direction:column;min-height:620px}
.exec-header{background:#1e1e1e;color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.exec-header h2{font-size:16px;font-weight:700;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.exec-header h2 i{color:var(--orange)}
.exec-kpi-badge{display:inline-flex;align-items:center;gap:5px;margin-left:4px;padding:4px 12px;background:linear-gradient(135deg,var(--orange),var(--orange-dark));color:#fff;font-size:10px;font-weight:800;border-radius:20px;box-shadow:0 3px 10px rgba(255,140,0,.45)}
.rel-header-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

.btn-action{font-family:'Poppins',sans-serif;padding:8px 16px;border:none;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px;transition:all .25s;white-space:nowrap;line-height:1.2}
.btn-action:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 5px 14px rgba(0,0,0,.18)}
.btn-action:disabled{opacity:.45;cursor:not-allowed;transform:none!important;box-shadow:none!important}
.btn-primary{background:var(--orange);color:#fff}
.btn-danger{background:#dc3545;color:#fff}
.btn-warning{background:#ffc107;color:#212529}
.btn-success{background:#28a745;color:#fff}
.btn-secondary{background:#6c757d;color:#fff}
.btn-info{background:#17a2b8;color:#fff}
.btn-purple{background:var(--purple);color:#fff}
.btn-blue{background:#0d6efd;color:#fff}
.btn-light{background:#fff;color:#0d6efd;border:1.5px solid #0d6efd}
.btn-sm{padding:5px 10px;font-size:10px}

.nav-relatorios-bar{display:flex;background:#2a2a2a;padding:0 20px;overflow-x:auto}
.nav-relatorios-bar button{font-family:'Poppins',sans-serif;background:transparent;border:none;border-bottom:3px solid transparent;color:rgba(255,255,255,.6);padding:11px 24px;font-size:13px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:all .25s;white-space:nowrap}
.nav-relatorios-bar button:hover{color:#fff;background:rgba(255,140,0,.06)}
.nav-relatorios-bar button.active{color:var(--orange);border-bottom-color:var(--orange);background:rgba(255,140,0,.05)}

.painel{display:none;flex-direction:column;flex:1;min-height:0}
.painel.active{display:flex;animation:fadePainel .25s ease}
@keyframes fadePainel{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ================= TOOLBAR ================= */
.exec-toolbar{background:#f8f9fa;border-bottom:1px solid #e5e5e5;padding:12px 20px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
.exec-toolbar .campo{display:flex;flex-direction:column;gap:4px;min-width:130px}
.exec-toolbar .campo label{font-size:9px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
.exec-toolbar .campo select,.exec-toolbar .campo input{padding:7px 10px;border:1.5px solid #ddd;border-radius:7px;font-family:'Poppins',sans-serif;font-size:12px;font-weight:600;color:var(--ink);background:#fff;outline:none;transition:border-color .2s,box-shadow .2s}
.exec-toolbar .campo select:focus,.exec-toolbar .campo input:focus{border-color:var(--orange);box-shadow:0 0 0 3px rgba(255,140,0,.12)}
.exec-toolbar .campo.busca{min-width:220px;flex:1 1 220px;max-width:360px}
.exec-body{flex:1;overflow:auto;padding:18px 22px 26px;background:#fff;color:#000;min-height:420px}

/* ================= VER CONTRACHEQUES ================= */
.split-layout{display:grid;grid-template-columns:380px minmax(0,1fr);gap:16px;min-height:560px;align-items:stretch}
@media(max-width:980px){.split-layout{grid-template-columns:1fr}}
.list-card{background:#fff;border:1px solid #e2e2e2;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;max-height:calc(100vh - 315px);min-height:480px;box-shadow:0 4px 16px rgba(0,0,0,.05)}
.list-card-head{background:#1e1e1e;color:#fff;padding:11px 14px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-shrink:0}
.list-card-head span{font-size:12px;font-weight:800;display:flex;align-items:center;gap:7px}
.list-card-head .contador{background:rgba(255,255,255,.15);padding:1px 9px;border-radius:10px;font-size:10px;font-weight:700}
.list-body{flex:1;overflow-y:auto;padding:9px;background:#fbfbfb}
.cc-item{display:flex;gap:9px;padding:10px;margin-bottom:7px;background:#fff;border:1.5px solid #e8e8e8;border-radius:9px;cursor:pointer;transition:all .2s;align-items:center}
.cc-item:hover{border-color:var(--purple);background:#faf7ff}
.cc-item.selected{border-color:var(--purple);background:var(--purple);color:#fff;box-shadow:0 5px 16px rgba(111,66,193,.28)}
.cc-item.selected .cc-sub,.cc-item.selected .cc-val{color:rgba(255,255,255,.88)}
.cc-item.selected .cc-val{color:#eaffea}
.cc-item .cc-icon{width:40px;height:48px;border-radius:7px;background:#f3e8ff;color:var(--purple);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;border:1px solid #e2d3ff}
.cc-item.selected .cc-icon{background:rgba(255,255,255,.18);color:#fff;border-color:rgba(255,255,255,.25)}
.cc-item .cc-body{flex:1;min-width:0}
.cc-item .cc-name{font-weight:800;font-size:12.5px;display:block;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cc-item .cc-sub{font-size:10px;color:#6c757d;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cc-item .cc-val{font-size:10.5px;font-weight:800;color:#28a745;margin-top:4px;display:block}

.viewer{background:#3e4147;border:1px solid #2f3237;border-radius:12px;overflow:auto;min-height:480px;max-height:calc(100vh - 315px);padding:14px;display:flex;flex-direction:column;align-items:center;gap:10px;position:relative}
.viewer canvas{display:block;max-width:100%;height:auto;background:#fff;box-shadow:0 6px 24px rgba(0,0,0,.5);border-radius:2px}
.viewer .placeholder{color:#c3c7ce;text-align:center;padding:80px 20px;font-size:13px;font-weight:600;line-height:1.7}
.viewer .placeholder i{font-size:48px;display:block;margin-bottom:14px;opacity:.45;color:#ffb457}
.viewer .placeholder small{font-size:11px;font-weight:400;opacity:.75}
.viewer-bar{color:#fff;font-size:11px;background:rgba(0,0,0,.65);padding:5px 12px;border-radius:14px;display:flex;gap:8px;align-items:center;margin-top:2px;flex-wrap:wrap;justify-content:center}
.viewer-bar button{background:rgba(255,255,255,.16);border:none;color:#fff;padding:3px 11px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:800;font-family:'Poppins',sans-serif;transition:background .2s}
.viewer-bar button:hover:not(:disabled){background:var(--orange)}
.viewer-bar button:disabled{opacity:.3;cursor:not-allowed}

/* ================= COMPETÊNCIA / IMPORTAÇÃO ================= */
.competencia-bar{background:#fff3cd;border-bottom:1px solid #ffe69c;padding:12px 20px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.competencia-bar .comp-title{display:flex;gap:9px;align-items:center;color:#856404;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.3px}
.competencia-bar .comp-title i{font-size:19px}
.competencia-bar .comp-controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.competencia-bar select,.competencia-bar input{padding:7px 10px;border:2px solid #ffc107;border-radius:7px;font-family:'Poppins',sans-serif;font-size:12px;font-weight:800;color:#856404;background:#fff;outline:none}
.competencia-bar input{width:86px}
.competencia-bar .comp-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.comp-badge{display:inline-flex;align-items:center;gap:5px;padding:5px 11px;border-radius:20px;font-size:10px;font-weight:800;background:#6c757d;color:#fff}
.comp-badge.locked{background:#28a745}
.comp-badge.unlocked{background:#dc3545}

.import-wrap{display:flex;flex-direction:column;gap:14px}
.import-summary{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;background:#f8f9fa;border:1px solid #eee;border-left:4px solid var(--orange);border-radius:10px;padding:11px 14px;font-size:12px;color:var(--muted)}
.import-summary strong{color:var(--ink)}
.import-summary .badge{background:#f3e8ff;color:var(--purple);padding:3px 9px;border-radius:12px;font-size:10px;font-weight:800}

.table-wrap{overflow:auto;max-height:calc(100vh - 400px);border:1px solid #ddd;border-radius:10px;background:#fff}
.data-table{width:100%;border-collapse:separate;border-spacing:0;font-size:11px;min-width:1080px}
.data-table thead th{background:#e9e9e9;color:#1a0a00;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.25px;padding:9px 7px;text-align:center;border-bottom:2px solid #cfcfcf;position:sticky;top:0;z-index:2;white-space:nowrap}
.data-table tbody td{padding:7px;border-bottom:1px solid #eee;text-align:center;white-space:nowrap;background:#fff}
.data-table tbody tr:nth-child(even) td{background:#fbfbfb}
.data-table tbody tr:hover td{background:#fff8ee}
.data-table .col-nome{text-align:left;font-weight:800;background:#fef3c7!important;min-width:220px;position:sticky;left:0;z-index:1}
.data-table thead .col-nome{z-index:3}
.data-table .num{text-align:right;font-weight:700;padding-right:9px}
.data-table .col-liq{background:#d1fae5!important;color:#155724;font-weight:800;font-size:12px}
.data-table tfoot td{background:#e4e4e4!important;font-weight:800;padding:10px 7px;border-top:2px solid #bbb;font-size:11px}
.data-table .sem-pdf{color:#b0b0b0;font-size:10px}
.data-table .acoes{display:flex;gap:4px;justify-content:center}
.data-table .btn-mini{border:none;border-radius:5px;padding:5px 7px;font-size:10px;cursor:pointer;color:#fff;font-family:'Poppins',sans-serif;transition:transform .2s}
.data-table .btn-mini:hover{transform:scale(1.08)}
.data-table .btn-mini.pdf{background:#17a2b8}
.data-table .btn-mini.del{background:#dc3545}

.empty-state{text-align:center;padding:60px 20px;color:var(--muted);line-height:1.65}
.empty-state i{font-size:48px;color:rgba(255,140,0,.35);margin-bottom:14px;display:block}
.empty-state p{font-size:14px;font-weight:700}
.empty-state small{font-size:11.5px;font-weight:400;color:#8a6a50;display:block;margin-top:5px}

/* ================= CONSOLIDADOR ================= */
.cons-toolbar{background:linear-gradient(135deg,#1e1e1e,#3a2408);color:#fff;border-radius:12px;padding:18px 20px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;border:1px solid rgba(255,140,0,.35)}
.cons-toolbar h2{font-size:17px;font-weight:800;display:flex;align-items:center;gap:9px;margin:0}
.cons-toolbar h2 i{color:var(--orange)}
.cons-toolbar p{font-size:11px;opacity:.82;margin-top:4px;line-height:1.5}
.cons-toolbar-botoes{display:flex;gap:8px;flex-wrap:wrap}
.cons-status{padding:11px 15px;border-radius:9px;font-size:12px;font-weight:600;margin-bottom:13px;display:flex;align-items:center;gap:9px;line-height:1.45}
.cons-status.ok{background:#d4edda;color:#155724;border-left:4px solid #28a745}
.cons-status.warn{background:#fff3cd;color:#856404;border-left:4px solid #ffc107}
.cons-status.err{background:#f8d7da;color:#721c24;border-left:4px solid #dc3545}
.cons-status.info{background:#d1ecf1;color:#0c5460;border-left:4px solid #17a2b8}
.cons-aviso{display:none;margin-top:14px;padding:13px 16px;background:#d1fae5;border-left:4px solid #28a745;border-radius:9px;font-size:12px;color:#155724;font-weight:600}
.cons-aviso.active{display:block}
.cons-lista-item{display:flex;gap:9px;padding:8px;margin-bottom:6px;background:#fff;border:1.5px solid #e2e2e2;border-radius:8px;cursor:pointer;transition:all .2s;align-items:center}
.cons-lista-item:hover{border-color:#0d6efd;background:#f1f7ff}
.cons-lista-item.selected{border-color:#0d6efd;background:#dbeafe}
.cons-lista-item.removida{opacity:.45;background:#fde8e8;border-color:#dc3545}
.cons-lista-item.removida .cons-info{text-decoration:line-through;color:#721c24}
.cons-thumb{width:54px;height:72px;object-fit:cover;border-radius:5px;border:1px solid #ccc;background:#fff;flex-shrink:0}
.cons-info{flex:1;min-width:0;font-size:10.5px}
.cons-info .nome{font-weight:800;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#1a0a00}
.cons-info .pag{display:block;color:#6c757d;font-size:9.5px;margin-top:2px}
.cons-mini{width:26px;height:26px;border-radius:5px;border:none;cursor:pointer;font-size:10px;display:inline-flex;align-items:center;justify-content:center;transition:transform .2s;flex-shrink:0;color:#fff}
.cons-mini:hover{transform:scale(1.12)}
.cons-mini.red{background:#f8d7da;color:#721c24}
.cons-mini.green{background:#d4edda;color:#155724}

/* ================= MODAIS ================= */
.modal{display:none;position:fixed;inset:0;z-index:10600;background:rgba(0,0,0,.68);backdrop-filter:blur(7px);justify-content:center;align-items:flex-start;overflow-y:auto;padding:20px}
.modal.active{display:flex}
.modal-box{background:#fff;border-radius:16px;padding:0;width:100%;max-width:980px;max-height:94vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,.38);animation:modalIn .25s ease}
@keyframes modalIn{from{opacity:0;transform:translateY(12px) scale(.99)}to{opacity:1;transform:none}}
.modal-box.wide{max-width:1600px}
.modal-box.medium{max-width:1080px}
.modal-box.small{max-width:620px}
.modal-box.tiny{max-width:480px}
.modal-head{background:#1e1e1e;color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-shrink:0}
.modal-head h3{font-size:15px;font-weight:800;display:flex;align-items:center;gap:9px;line-height:1.35}
.modal-head h3 i{color:var(--orange)}
.modal-head .modal-close{background:rgba(255,255,255,.12);border:none;color:#fff;width:32px;height:32px;border-radius:8px;font-size:20px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.modal-head .modal-close:hover{background:#dc3545}
.modal-body{padding:18px 20px;overflow-y:auto;flex:1}
.modal-actions{display:flex;justify-content:flex-end;gap:9px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid #eee}
.modal-actions.between{justify-content:space-between}

.status-box{padding:10px 14px;border-radius:8px;font-size:12px;font-weight:600;margin-bottom:13px;display:flex;align-items:center;gap:8px;line-height:1.45}
.status-box.ok{background:#d4edda;color:#155724;border-left:4px solid #28a745}
.status-box.warn{background:#fff3cd;color:#856404;border-left:4px solid #ffc107}
.status-box.err{background:#f8d7da;color:#721c24;border-left:4px solid #dc3545}
.status-box.info{background:#d1ecf1;color:#0c5460;border-left:4px solid #17a2b8}

.comp-lock{background:#f8d7da;border:2px solid #dc3545;border-radius:9px;padding:12px 15px;margin-bottom:13px;display:none;align-items:center;gap:11px}
.comp-lock.show{display:flex}
.comp-lock i{font-size:23px;color:#dc3545}
.comp-lock strong{display:block;color:#721c24;font-size:13px}
.comp-lock span{color:#721c24;font-size:11.5px;line-height:1.45}

.file-box{background:#f8f9fa;border:2px solid var(--orange);border-radius:10px;padding:13px;margin-bottom:13px}
.file-box label{font-size:11.5px;font-weight:800;color:var(--muted);display:block;margin-bottom:7px}
.file-box input[type=file]{width:100%;padding:9px;border:1px solid #ccc;border-radius:6px;background:#fff;font-family:'Poppins',sans-serif;font-size:11.5px}
.file-actions{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}

.import-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;align-items:stretch}
@media(max-width:1000px){.import-layout{grid-template-columns:1fr}}
.pdf-panel{border:1px solid #ddd;border-radius:9px;background:#f8f9fa;overflow:hidden;display:flex;flex-direction:column;min-height:470px;max-height:64vh}
.pdf-panel-head{background:#1e1e1e;color:#fff;padding:8px 13px;font-size:10.5px;font-weight:700;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-shrink:0}
.pdf-panel-head i{color:var(--orange)}
.pdf-panel-body{flex:1;overflow:auto;background:#4d5157;padding:10px;display:flex;flex-direction:column;align-items:center;gap:10px}
.pdf-panel-body canvas{display:block;max-width:100%;height:auto;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.45)}
.pdf-placeholder{color:#c7cbd1;text-align:center;padding:50px 20px;font-size:12px;line-height:1.7}
.pdf-placeholder i{font-size:44px;display:block;margin-bottom:12px;opacity:.5;color:#ffb457}
.import-preview-box{border:1px solid #ddd;border-radius:9px;background:#fff;overflow:auto;max-height:64vh;min-height:470px}
.import-preview{width:100%}
.import-preview table{width:100%;border-collapse:collapse;font-size:10.5px;min-width:560px}
.import-preview thead th{background:#f0f0f0;padding:8px 5px;font-size:8.5px;font-weight:800;text-transform:uppercase;border-bottom:2px solid #ccc;text-align:center;position:sticky;top:0;z-index:2;white-space:nowrap}
.import-preview tbody td{padding:6px 5px;border-bottom:1px solid #eee;text-align:center;white-space:nowrap}
.import-preview tbody tr:nth-child(even) td{background:#fcfcfc}
.import-preview .nome-cell{font-weight:800;text-align:left;background:#fef3c7!important;font-size:10.5px;white-space:normal;min-width:150px}
.import-preview .num{text-align:right;font-weight:700}
.import-preview .ok-badge{display:inline-block;background:#d4edda;color:#155724;font-size:7px;font-weight:800;padding:1px 5px;border-radius:7px;margin-left:3px;text-transform:uppercase}
.import-preview .pend-badge{display:inline-block;background:#f8d7da;color:#721c24;font-size:7px;font-weight:800;padding:1px 5px;border-radius:7px;margin-left:3px;text-transform:uppercase}
.import-preview .alerta{display:block;background:#fff3cd;color:#856404;font-size:9px;font-weight:700;padding:3px 6px;border-radius:4px;margin-top:3px;border:1px solid #ffc107;white-space:normal;text-align:left}
.import-preview .vazio{color:#aaa;font-style:italic}
.count-pill{display:inline-flex;align-items:center;gap:4px;background:var(--orange);color:#fff;font-size:10px;font-weight:800;border-radius:14px;padding:2px 9px;margin-left:5px}

/* ============ VALIDAÇÃO ============ */
.val-aviso{background:#f3e8ff;border-left:4px solid var(--purple);border-radius:8px;padding:11px 14px;font-size:11.5px;color:var(--purple-dark);margin-bottom:14px;line-height:1.55}
.val-lista{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:13px}
.val-lista button{font-family:'Poppins',sans-serif;border:1.5px solid #d0c4e8;background:#fff;color:var(--purple-dark);border-radius:7px;padding:5px 9px;font-size:10.5px;font-weight:700;cursor:pointer;transition:all .2s;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.val-lista button:hover{background:#f3e8ff}
.val-lista button.atual{outline:2px solid var(--purple);outline-offset:1px}
.val-lista button.ok{border-color:#28a745;background:#eaffea;color:#155724}
.val-lista button.pendente{border-color:#ffc107;background:#fffbe6;color:#856404}
.val-func{margin-bottom:13px}
.val-func label{font-size:10.5px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:5px}
.val-func input{width:100%;padding:9px 11px;border:2px solid var(--purple);border-radius:8px;font-family:'Poppins',sans-serif;font-size:12.5px;font-weight:700;background:#f3e8ff;color:var(--purple-dark);outline:none}
.val-func input:focus{box-shadow:0 0 0 3px rgba(111,66,193,.14)}
.val-func input.ok{border-color:#28a745;background:#eaffea;color:#155724}
.val-func input.pendente{border-color:#ffc107;background:#fffbe6;color:#856404}
.val-func .val-dica{margin-top:6px;font-size:10px;color:#6c757d;line-height:1.5}
.val-func .val-dica.ok{color:#155724}
.val-func .val-dica.novo{color:#856404}
.val-sugestao{margin-top:5px;font-size:10.5px;color:var(--purple);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.val-sugestao button{background:var(--purple);color:#fff;border:none;border-radius:5px;padding:2px 7px;font-size:9.5px;font-weight:700;cursor:pointer;font-family:'Poppins',sans-serif}
.val-secao{font-size:10.5px;font-weight:800;color:var(--purple-dark);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 7px;padding-bottom:4px;border-bottom:1px dashed #d0c4e8}
.val-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:9px}
.val-campo{display:flex;flex-direction:column;gap:3px}
.val-campo label{font-size:9px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.3px}
.val-campo input{padding:7px 9px;border:1.5px solid #d0c4e8;border-radius:7px;font-family:'Poppins',sans-serif;font-size:12px;font-weight:600;color:var(--ink);outline:none}
.val-campo input:focus{border-color:var(--purple);box-shadow:0 0 0 3px rgba(111,66,193,.14)}
.val-campo input.corrigido{border-color:#28a745;background:#eaffea}
.val-campo small{font-size:8.5px;color:#999;font-style:italic}
.val-footer{display:flex;justify-content:space-between;align-items:center;gap:9px;flex-wrap:wrap;margin-top:16px;padding-top:13px;border-top:2px solid #eee}
.val-nav{display:flex;gap:7px;align-items:center}
.val-contador{font-size:11px;font-weight:800;color:var(--purple);background:#f3e8ff;padding:5px 12px;border-radius:15px}

/* ============ NOMES PENDENTES ============ */
.pend-aviso{background:#f8d7da;border-left:4px solid #dc3545;border-radius:8px;padding:11px 14px;font-size:11.5px;color:#721c24;margin-bottom:13px;line-height:1.55}
.pend-item{background:#f8f9fa;border:1px solid #eee;border-radius:9px;padding:12px;margin-bottom:9px}
.pend-nome{font-weight:800;color:var(--ink);font-size:13px;margin-bottom:3px}
.pend-nome i{color:#dc3545;margin-right:5px}
.pend-dados{font-size:10px;color:#6c757d;margin-bottom:9px;display:flex;gap:10px;flex-wrap:wrap}
.pend-label{font-size:10px;font-weight:800;color:var(--muted);margin-bottom:5px}
.pend-sugestoes{display:flex;flex-direction:column;gap:5px}
.pend-sugestao{display:flex;align-items:center;gap:7px;background:#fff;border:1.5px solid #d0c4e8;border-radius:7px;padding:7px 10px;cursor:pointer;font-family:'Poppins',sans-serif;font-size:11px;color:var(--purple-dark);text-align:left;width:100%;transition:all .2s}
.pend-sugestao:hover{background:#f3e8ff;border-color:var(--purple)}
.pend-sugestao.selected{background:var(--purple);color:#fff;border-color:var(--purple)}
.pend-sugestao .pct{font-size:8px;font-weight:800;padding:2px 6px;border-radius:8px;background:#28a745;color:#fff;margin-left:auto;flex-shrink:0}
.pend-sugestao .pct.baixa{background:#ffc107;color:#212529}
.pend-sugestao .pct.media{background:#fd7e14}
.pend-select{width:100%;padding:7px 10px;border:2px solid var(--purple);border-radius:7px;font-family:'Poppins',sans-serif;font-size:11px;font-weight:600;background:#fff;color:var(--purple-dark);outline:none;margin-top:7px}
.pend-cadastrar{width:100%;margin-top:7px;justify-content:center}
.pend-nome-campo{margin:9px 0 7px}
.pend-nome-campo label{font-size:9.5px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.3px;display:block;margin-bottom:3px}
.pend-nome-input{width:100%;padding:8px 10px;border:1.5px solid #d0c4e8;border-radius:7px;font-family:'Poppins',sans-serif;font-size:12px;font-weight:700;color:var(--purple-dark);background:#fff;outline:none}
.pend-nome-input:focus{border-color:var(--purple);box-shadow:0 0 0 3px rgba(111,66,193,.12)}
#modalNomesPendentes .modal-head{background:#fff;color:var(--ink);border-bottom:2px solid #dc3545;padding:15px 20px}
#modalNomesPendentes .modal-head h3{font-size:18px;color:var(--ink)}
#modalNomesPendentes .modal-head h3 i{color:#dc3545}
#modalNomesPendentes .modal-head .modal-close{background:#f1f3f5;color:#333}
#modalNomesPendentes .modal-head .modal-close:hover{background:#dc3545;color:#fff}

/* ============ CADASTRO RÁPIDO ============ */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.form-grid .full{grid-column:1/-1}
.form-field{display:flex;flex-direction:column;gap:3px}
.form-field label{font-size:9.5px;font-weight:800;color:var(--muted);text-transform:uppercase}
.form-field input,.form-field select{padding:8px 10px;border:1.5px solid #ddd;border-radius:7px;font-family:'Poppins',sans-serif;font-size:12px;outline:none;background:#fff}
.form-field input:focus,.form-field select:focus{border-color:#28a745;box-shadow:0 0 0 3px rgba(40,167,69,.1)}
.form-erro{display:none;background:#f8d7da;color:#721c24;padding:9px 12px;border-radius:7px;font-size:11px;margin-bottom:10px;border-left:4px solid #dc3545;line-height:1.45}

/* ============ PROGRESSO ============ */
.progress-box{background:#fff;border-radius:14px;padding:28px;max-width:460px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.progress-box i{font-size:40px;color:var(--orange);margin-bottom:13px;display:block}
.progress-box h3{font-size:17px;margin-bottom:6px;color:var(--ink)}
.progress-box p{font-size:12px;color:var(--muted);margin-bottom:14px}
.progress-bar{width:100%;height:8px;background:#f0f0f0;border-radius:4px;overflow:hidden;margin-bottom:9px}
.progress-bar-inner{height:100%;background:linear-gradient(90deg,var(--orange),var(--orange-dark));width:0%;transition:width .3s;border-radius:4px}
.progress-status{font-size:10.5px;color:#6c757d;font-style:italic}

/* ============ TOAST ============ */
.toast{position:fixed;bottom:20px;right:20px;background:#28a745;color:#fff;padding:14px 22px;border-radius:9px;font-size:13px;font-weight:700;box-shadow:0 8px 28px rgba(0,0,0,.28);z-index:12000;display:none;animation:slideIn .3s ease;max-width:430px;line-height:1.45}
.toast.show{display:block}
.toast.error{background:#dc3545}
.toast.warning{background:#ffc107;color:#212529}
.toast.info{background:#17a2b8}
@keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

/* ============ RESPONSIVO ============ */
@media(max-width:1100px){
  .exec-header{padding:12px 14px}
  .exec-body{padding:14px}
  .nav-relatorios-bar{padding:0 10px}
  .nav-relatorios-bar button{padding:10px 15px;font-size:12px}
  .competencia-bar{padding:11px 14px}
  .exec-toolbar{padding:10px 14px}
}
@media(max-width:720px){
  .main-header{height:auto;min-height:46px;flex-wrap:wrap;padding:5px 10px}
  .nav-menu{overflow-x:auto;max-width:100%}
  .user-info{display:none}
  .container{padding:64px 10px 20px}
  .page-title h1{font-size:21px}
  .exec-header h2{font-size:14px}
  .rel-header-actions{width:100%;justify-content:flex-start}
  .exec-toolbar .campo.busca{max-width:none}
  .split-layout{grid-template-columns:1fr}
  .list-card,.viewer{max-height:58vh;min-height:360px}
  .competencia-bar{flex-direction:column;align-items:flex-start}
  .competencia-bar .comp-controls,.competencia-bar .comp-actions{width:100%}
  .form-grid{grid-template-columns:1fr}
  .modal{padding:8px}
  .modal-box{max-height:97vh;border-radius:12px}
  .modal-body{padding:14px}
  .import-layout{grid-template-columns:1fr}
  .pdf-panel,.import-preview-box{max-height:46vh;min-height:320px}
  .val-grid{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<div class="toast" id="toastSucesso"><i class="fas fa-check-circle"></i> <span id="toastMsg">Salvo!</span></div>

<header class="main-header">
    <div class="logo">Apli<span>kado</span></div>
    <nav class="nav-menu">
        <a href="MODULOI_QNUTRI.html" onclick="localStorage.removeItem('apliKado_ponto_session');"><i class="fas fa-arrow-left"></i> <span>Voltar ao Ponto</span></a>
        <a href="#" onclick="recarregarTudo();return false;"><i class="fas fa-sync"></i> <span>Recarregar</span></a>
        <span class="user-info">
            <i class="fas fa-user-circle"></i>
            <span id="headerUserName">Usuário</span>
            <span class="user-role" id="headerUserRole">VIEWER</span>
        </span>
    </nav>
</header>

<div class="container">
    <div class="page-title">
        <h1><i class="fas fa-file-invoice-dollar"></i> Contracheques</h1>
        <div class="page-subtitle">Importação, conferência e consolidação de contracheques em PDF</div>
    </div>

    <div class="exec-container" id="execContainer">
        <div class="exec-header">
            <h2>
                <i class="fas fa-file-invoice-dollar"></i> Gestão de Contracheques
                <span class="exec-kpi-badge" id="kpiContracheques"><i class="fas fa-folder-open"></i> <span id="kpiContrachequesValor">0</span> registro(s)</span>
            </h2>
            <div class="rel-header-actions">
                <button type="button" class="btn-action btn-purple" onclick="navegarParaAba('importar')"><i class="fas fa-file-import"></i> Importar Contra Cheque</button>
                <button type="button" class="btn-action btn-info" onclick="navegarParaAba('consolidador')"><i class="fas fa-object-group"></i> Consolidador PDF</button>
                <button type="button" class="btn-action btn-primary" onclick="recarregarTudo()"><i class="fas fa-sync"></i> Atualizar</button>
            </div>
        </div>

        <div class="nav-relatorios-bar">
            <button type="button" id="btnNavVer" class="active" onclick="navegarParaAba('ver')"><i class="fas fa-file-invoice"></i> Ver Contracheques</button>
            <button type="button" id="btnNavImportar" onclick="navegarParaAba('importar')"><i class="fas fa-file-import"></i> Importar Contra Cheque</button>
            <button type="button" id="btnNavConsolidador" onclick="navegarParaAba('consolidador')"><i class="fas fa-object-group"></i> Consolidador PDF</button>
        </div>

        <!-- ================= PAINEL VER ================= -->
        <div class="painel active" id="painelVer">
            <div class="exec-toolbar">
                <div class="campo" style="min-width:135px;">
                    <label><i class="fas fa-calendar"></i> Mês</label>
                    <select id="verMes"></select>
                </div>
                <div class="campo" style="min-width:85px;">
                    <label><i class="fas fa-calendar-alt"></i> Ano</label>
                    <input type="number" id="verAno" value="2026" min="2020" max="2035">
                </div>
                <div class="campo busca">
                    <label><i class="fas fa-search"></i> Buscar colaborador</label>
                    <input type="text" id="verBusca" placeholder="Nome do colaborador...">
                </div>
                <button type="button" class="btn-action btn-primary" onclick="carregarVerContracheques()"><i class="fas fa-search"></i> Carregar</button>
                <button type="button" class="btn-action btn-secondary" onclick="limparCacheVer()"><i class="fas fa-broom"></i> Limpar Cache</button>
            </div>
            <div class="exec-body">
                <div class="split-layout">
                    <div class="list-card">
                        <div class="list-card-head">
                            <span><i class="fas fa-list"></i> Contracheques <span class="contador" id="verContador">0</span></span>
                        </div>
                        <div class="list-body" id="verLista">
                            <div class="empty-state" style="padding:40px 14px;">
                                <i class="fas fa-inbox"></i>
                                <p>Carregando...</p>
                            </div>
                        </div>
                    </div>
                    <div class="viewer" id="verViewer">
                        <div class="placeholder">
                            <i class="fas fa-file-pdf"></i>
                            Selecione um contracheque à esquerda.
                            <small>O PDF fica salvo no próprio registro do contracheque.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= PAINEL IMPORTAR ================= -->
        <div class="painel" id="painelImportar">
            <div class="competencia-bar">
                <div class="comp-title"><i class="fas fa-bullseye"></i> Competência</div>
                <div class="comp-controls">
                    <select id="ccMes" title="Mês de referência"></select>
                    <input type="number" id="ccAno" value="2026" min="2020" max="2035" title="Ano de referência">
                    <button type="button" class="btn-action btn-success" onclick="confirmarCompetencia()"><i class="fas fa-check-double"></i> Confirmar Competência</button>
                    <span class="comp-badge unlocked" id="competenciaBadge"><i class="fas fa-lock-open"></i> Não confirmada</span>
                </div>
                <div class="comp-actions">
                    <button type="button" class="btn-action btn-purple" id="btnAbrirImportacao" onclick="abrirModalImportacao()" disabled><i class="fas fa-file-pdf"></i> Importar PDF</button>
                    <button type="button" class="btn-action btn-danger" id="btnLimparDados" onclick="limparDadosContracheque()" disabled><i class="fas fa-trash"></i> Limpar Dados</button>
                    <button type="button" class="btn-action btn-info" id="btnSincronizar" onclick="sincronizarContracheques()" disabled><i class="fas fa-cloud-upload-alt"></i> Sincronizar</button>
                </div>
            </div>
            <div class="exec-body" id="importPainelBody">
                <div class="empty-state">
                    <i class="fas fa-lock"></i>
                    <p>Competência não confirmada.</p>
                    <small>Escolha o Mês/Ano acima e clique em <strong>Confirmar Competência</strong>.</small>
                </div>
            </div>
        </div>

        <!-- ================= PAINEL CONSOLIDADOR ================= -->
        <div class="painel" id="painelConsolidador">
            <div class="exec-body">
                <div class="cons-toolbar">
                    <div>
                        <h2><i class="fas fa-object-group"></i> Consolidador de Contracheques PDF</h2>
                        <p>Importe vários PDFs (1 ou mais páginas), consolide em um único arquivo, remova páginas indesejadas e exporte.</p>
                    </div>
                    <div class="cons-toolbar-botoes">
                        <button type="button" class="btn-action btn-light" onclick="consImportar()"><i class="fas fa-file-import"></i> Importar PDFs</button>
                        <button type="button" class="btn-action btn-success" id="btnConsolidar" onclick="consConsolidar()" disabled><i class="fas fa-layer-group"></i> Consolidar</button>
                        <button type="button" class="btn-action btn-warning" id="btnExportarConsolidado" onclick="consExportar()" disabled><i class="fas fa-file-export"></i> Exportar PDF</button>
                        <button type="button" class="btn-action btn-danger" onclick="consLimpar()"><i class="fas fa-trash"></i> Limpar Tudo</button>
                    </div>
                </div>

                <div id="consStatus" class="cons-status info"><i class="fas fa-info-circle"></i><span>Nenhum PDF importado. Clique em <strong>Importar PDFs</strong> para começar.</span></div>

                <input type="file" id="consFileInput" accept=".pdf" multiple style="display:none;">

                <div class="split-layout">
                    <div class="list-card">
                        <div class="list-card-head">
                            <span><i class="fas fa-list"></i> Páginas <span class="contador" id="consContador">0</span></span>
                            <div style="display:flex;gap:4px;">
                                <button type="button" class="cons-mini green" onclick="consRestaurarTodas()" title="Restaurar todas"><i class="fas fa-undo"></i></button>
                                <button type="button" class="cons-mini red" onclick="consRemoverTodas()" title="Remover todas"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        <div class="list-body" id="consLista">
                            <div class="empty-state" style="padding:40px 14px;"><i class="fas fa-inbox"></i><p>Importe PDFs para ver as páginas.</p></div>
                        </div>
                    </div>
                    <div class="viewer" id="consViewer">
                        <div class="placeholder"><i class="fas fa-file-pdf"></i>Selecione uma página à esquerda para visualizar.</div>
                    </div>
                </div>

                <div class="cons-aviso" id="consAviso">
                    <i class="fas fa-check-circle"></i> <strong>Arquivo consolidado pronto!</strong> <span id="consTexto"></span>
                    <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">
                        <button type="button" class="btn-action btn-info btn-sm" onclick="consVisualizar()"><i class="fas fa-eye"></i> Visualizar Consolidado</button>
                        <button type="button" class="btn-action btn-success btn-sm" onclick="consExportar()"><i class="fas fa-download"></i> Exportar Consolidado</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL IMPORTAÇÃO ================= -->
<div class="modal" id="modalImport">
    <div class="modal-box wide">
        <div class="modal-head">
            <h3><i class="fas fa-file-pdf"></i> Importar Contra Cheque (PDF)</h3>
            <button type="button" class="modal-close" onclick="fecharModalImportacao()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="comp-lock" id="avisoCompetenciaImportacao">
                <i class="fas fa-lock"></i>
                <div>
                    <strong>Competência Travada</strong>
                    <span>Os dados deste PDF serão salvos em: <strong id="txtCompetenciaTravada"></strong></span>
                </div>
            </div>

            <div class="status-box info" id="importStatus">
                <i class="fas fa-info-circle"></i>
                <span>Selecione o arquivo PDF do contracheque. O sistema tentará extrair os dados automaticamente usando a estrutura visual (coordenadas X/Y).</span>
            </div>

            <div class="file-box">
                <label><i class="fas fa-upload"></i> Selecione o arquivo PDF:</label>
                <input type="file" id="importFileInput" accept=".pdf">
                <div class="file-actions">
                    <button type="button" class="btn-action btn-primary" id="btnExtrairPDF" onclick="processarPDFImportacao()"><i class="fas fa-crosshairs"></i> Extrair e Validar Dados</button>
                    <button type="button" class="btn-action btn-secondary" onclick="document.getElementById('importFileInput').value='';"><i class="fas fa-eraser"></i> Limpar Arquivo</button>
                </div>
            </div>

            <div class="import-layout">
                <div class="pdf-panel">
                    <div class="pdf-panel-head">
                        <span><i class="fas fa-file-pdf"></i> Visualização do PDF</span>
                        <span id="pdfPageInfo" style="font-size:9.5px;color:#aaa;"></span>
                    </div>
                    <div class="pdf-panel-body" id="pdfViewerBody">
                        <div class="pdf-placeholder">
                            <i class="fas fa-file-pdf"></i>
                            Selecione um arquivo PDF e clique em <strong>Extrair e Validar Dados</strong> para visualizar.
                        </div>
                    </div>
                </div>
                <div class="import-preview-box">
                    <div style="padding:10px 12px;border-bottom:1px solid #eee;font-size:11.5px;font-weight:800;color:#1a0a00;background:#fafafa;position:sticky;top:0;z-index:3;">
                        <i class="fas fa-users" style="color:#FF8C00;"></i> Colaboradores identificados
                        <span class="count-pill" id="importCount">0</span>
                        <div style="font-size:9.5px;font-weight:500;color:#7a3a00;margin-top:3px;">Após extrair, clique em <strong>Validar e Salvar</strong> para corrigir e confirmar os valores.</div>
                    </div>
                    <div class="import-preview" id="importPreview">
                        <div class="empty-state" style="padding:45px 20px;"><i class="fas fa-inbox"></i><p>Nenhum colaborador processado.</p></div>
                    </div>
                </div>
            </div>

