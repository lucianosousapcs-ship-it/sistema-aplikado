async function verSelecionar(idx){
    const cc = _verLista[idx];
    if(!cc) return;
    _verSelecionado = cc;
    renderizarListaVer();
    const viewer = document.getElementById('verViewer');
    _verPdfDoc = null;
    _verPaginaAtual = 1;
    _verTotalPaginas = 1;
    try{
        const { data: completo, error } = await db
            .from('contracheques')
            .select('id, arquivo_base64, arquivo_nome, dados_brutos')
            .eq('id', cc.id)
            .maybeSingle();
        if(error) throw error;

        let bytes = _verBytesCache.get(String(cc.id));
        if(!bytes){
            if(completo && completo.arquivo_base64){
                bytes = base64ParaBytes(completo.arquivo_base64);
            }else{
                const caminho = caminhoPdfRegistro(completo);
                if(!caminho) throw new Error('Este contracheque não tem PDF salvo.');
                const { data: blob, error: errStorage } = await db.storage.from('contracheques').download(caminho);
                if(errStorage) throw errStorage;
                bytes = new Uint8Array(await blob.arrayBuffer());
            }
            _verBytesCache.set(String(cc.id), bytes);
        }
        if(_verSelecionado !== cc) return;
        viewer.innerHTML = `<div class="placeholder"><i class="fas fa-spinner fa-spin"></i>Renderizando PDF...</div>`;
        const pdf = await pdfjsLib.getDocument({ data: bytes.slice(0) }).promise;
        _verPdfDoc = pdf;
        _verTotalPaginas = pdf.numPages;
        const paginaRegistro = paginaPdfRegistro(completo);
        await verRenderPagina(Math.min(Math.max(paginaRegistro, 1), pdf.numPages));
    }catch(e){
        console.error('Erro ao abrir PDF:', e);
        if(_verSelecionado !== cc) return;
        viewer.innerHTML = `<div class="placeholder"><i class="fas fa-exclamation-triangle" style="color:#ffc107;"></i>PDF não disponível.<small>${escaparHTML(e.message || e)}</small></div>`;
    }
}
async function verRenderPagina(num){
    if(!_verPdfDoc) return;
    const viewer = document.getElementById('verViewer');
    const docAtual = _verPdfDoc;
    const seq = ++_verRenderSeq;
    try{
        _verPaginaAtual = num;
        const page = await docAtual.getPage(num);
        const vp = page.getViewport({ scale: 1.45 });
        const canvas = document.createElement('canvas');
        canvas.width = vp.width;
        canvas.height = vp.height;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
        if(seq !== _verRenderSeq || docAtual !== _verPdfDoc) return;
        viewer.innerHTML = '';
        viewer.appendChild(canvas);
        const bar = document.createElement('div');
        bar.className = 'viewer-bar';
        bar.innerHTML = `
            <button ${num <= 1 ? 'disabled' : ''} onclick="verRenderPagina(${num-1})">◀</button>
            <span>Página ${num} de ${_verTotalPaginas}</span>
            <button ${num >= _verTotalPaginas ? 'disabled' : ''} onclick="verRenderPagina(${num+1})">▶</button>
            <button onclick="verBaixarPdf()"><i class="fas fa-download"></i> Baixar</button>
        `;
        viewer.appendChild(bar);
    }catch(e){
        viewer.innerHTML = `<div class="placeholder"><i class="fas fa-exclamation-triangle" style="color:#ff8a8a;"></i>Erro ao renderizar página.<small>${escaparHTML(e.message || e)}</small></div>`;
    }
}
function verBaixarPdf(){
    if(!_verSelecionado) return;
    const bytes = _verBytesCache.get(String(_verSelecionado.id));
    if(!bytes){
        mostrarToast('⚠️ PDF ainda não carregado.', 'warning');
        return;
    }
    const blob = new Blob([bytes], {type:'application/pdf'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = _verSelecionado.arquivo_nome || `contracheque_${_verSelecionado.funcionario_nome || 'arquivo'}.pdf`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 3000);
}
